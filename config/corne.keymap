#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/led/led.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/reset.h>

&led_strip {
    chain-length = <27>;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "BAS";
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&none   &kp Q        &kp W       &kp E          &kp R        &kp T         &kp Y     &kp U        &kp I           &kp O         &kp P           &none
&none   &mt LSHFT A  &mt LCMD S  &mt LALT D     &mt LCTRL F  &kp  G        &kp  H    &mt RCTRL J  &mt RALT K      &mt RCMD L    &mt RSHFT SEMI  &none
&none   &kp Z      &kp X       &kp C          &kp V        &kp B         &kp N     &kp M        &kp COMMA       &kp DOT         &kp FSLH      &none
                                 &mt LGUI ESC   &kp TAB    &kp SPACE     &kp RET   &kp BSPC   &kp RALT
            >;
        };

        lower_layer {
            display-name = "LOW";
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&none  &none         &kp F17       &kp UP        &kp F18       &none           &kp LBKT  &kp RBKT  &kp GRAVE    &kp TILDE    &kp BSPC  &none
&none  &none         &kp LEFT      &kp DOWN      &kp RIGHT     &none           &kp PLUS  &kp MINUS &kp ASTRK    &kp EQUAL    &kp SQT   &none
&none  &none         &none         &none         &none         &none           &kp LBRC  &kp RBRC  &kp PIPE     &kp PIPE     &kp BSLH  &none
                                   &kp BSPC      &trans        &kp RET         &trans    &trans    &trans      
            >;
        };

        raise_layer {
            display-name = "RAI";
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &kp C_PLAY_PAUSE  &kp C_VOL_DN   &kp C_MUTE   &kp C_VOL_UP  &none     &none
&none  &trans        &trans        &trans        &trans        &trans        &kp LEFT          &kp DOWN       &kp UP       &kp RIGHT     &none     &none
&none  &trans        &trans        &trans        &trans        &trans        &none             &none          &none        &none         &none     &none
                                   &trans        &trans        &out OUT_TOG  &trans            &trans         &bt BT_CLR      
            >;
        };

        numeric_layer {
            display-name = "NUM";
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&none  &kp EXCL      &kp AT        &kp HASH      &kp DOLLAR    &kp PERCENT   &kp CARET         &kp AMPERS     &kp ASTRK    &kp LPRN      &kp RPRN  &none
&none  &kp N1        &kp N2        &kp N3        &kp N4        &kp N5        &kp N6            &kp N7         &kp N8       &kp N9        &kp N0    &none
&none  &trans        &trans        &trans        &trans        &trans        &none             &none          &none        &none         &none     &none
                                   &trans        &trans        &trans        &trans            &trans         &trans                       
            >;
        };


        // extra_1 {
        //     status = "reserved";
        // };

        extra_2 {
            status = "reserved";
        };

        extra_3 {
            status = "reserved";
        };
    };
};
