#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/led/led.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/reset.h>

&led_strip {
    chain-length = <27>;
};

/ {
    behaviors {
        hr_mt: homerow_mt {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MT";
            #binding-cells = <2>;

            flavor = "balanced";
            tapping-term-ms = <120>;
            quick-tap-ms = <100>;
            require-prior-idle-ms = <80>;

            bindings = <&kp>, <&kp>;
        };
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "BAS";
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&none   &kp Q        &kp W          &kp E           &kp R           &kp T         &kp Y     &kp U           &kp I           &kp O         &kp P           &none
&none   &hr_mt LSHFT A  &hr_mt LCMD S  &hr_mt LALT D   &hr_mt LCTRL F  &kp  G        &kp  H    &hr_mt RCTRL J  &hr_mt RALT K   &hr_mt RCMD L &hr_mt RSHFT SEMI  &none
&none   &lt 3 Z      &kp X          &kp C           &kp V           &kp B         &kp N     &kp M           &kp COMMA       &kp DOT       &lt 3 FSLH      &none
                                    &mt LGUI ESCAPE &lt 1 TAB       &kp SPACE     &lt 2 RET &kp BSPC        &kp RALT
            >;
        };

        lower_layer {
            display-name = "LOW";
            // -----------------------------------------------------------------------------------------
            // |     | SLP | F17 |  UP | F18 |     |   | LBKT| RBKT| GRAV| TILD|  0  | BKSP |
            // |     |     | LFT | DWN | RIG |     |   | PLUS| MINS| ASTR| EQU |     |      |
            // |     |     |     |     |     | SCR |   | LBRC| RBRC| PIPE| PIPE| BSLH|      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&none  &kp LG(LC(Q)) &kp F17       &kp UP        &kp F18       &none          &kp LBKT  &kp RBKT  &kp GRAVE    &kp TILDE    &kp DEL   &none
&none  &none         &kp LEFT      &kp DOWN      &kp RIGHT     &none          &kp PLUS  &kp MINUS &kp ASTRK    &kp EQUAL    &kp SQT   &none
&none  &none         &none         &none         &none         &kp LS(LG(N4)) &kp LBRC  &kp RBRC  &kp PIPE     &kp PIPE     &kp BSLH  &none
                                   &kp BSPC      &trans        &kp RET        &trans    &trans    &trans
            >;
        };

        raise_layer {
            display-name = "RAI";
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &kp C_PLAY_PAUSE  &kp C_VOL_DN   &kp C_MUTE   &kp C_VOL_UP  &none     &none
&none  &none         &none         &none         &none         &none         &kp LEFT          &kp DOWN       &kp UP       &kp RIGHT     &none     &none
&none  &none         &none         &none         &none         &none         &none             &none          &none        &none         &none     &none
                                   &trans        &trans        &out OUT_TOG  &trans            &trans         &bt BT_CLR
            >;
        };

        numeric_layer {
            display-name = "NUM";
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&none  &kp EXCL      &kp AT        &kp HASH      &kp DOLLAR    &kp PERCENT     &kp CARET &kp AMPS  &kp ASTRK    &kp LPAR     &kp RPAR  &none
&none  &kp N1        &kp N2        &kp N3        &kp N4        &kp N5          &kp N6    &kp N7    &kp N8       &kp N9       &kp N0    &none
&none  &none         &none         &none         &none         &none           &none     &none     &trans       &trans       &trans    &none
                                   &trans        &trans        &trans          &trans    &trans    &trans
            >;
        };


        extra_1 {
            status = "reserved";
        };

        extra_2 {
            status = "reserved";
        };

        extra_3 {
            status = "reserved";
        };
    };
};
